{
  "archinstall-language": "Polish",
  "additional-repositories": ["multilib"],
  "audio_config": { "audio": "pulseaudio" },
  "bootloader_config": {
    "bootloader": "limine",
    "uki": false,
    "removable": false
  },
  "hostname": "archlinux",
  "kernels": ["linux"],
  "ntp": true,
  "packages": ["gnome-initial-setup", "gnome", "prismlauncher"],
  "swap": true,
  "timezone": "UTC",
  "custom-commands": ["systemctl enable NetworkManager"]
}